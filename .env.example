# --- Database -------------------------------------------------------------
# Runtime connection: through PgBouncer (transaction pooling).
DATABASE_URL="postgresql://assetflow:assetflow@localhost:6432/assetflow?schema=public&pgbouncer=true"
# Direct connection to Postgres: used by migrations (they cannot use the pooler).
DIRECT_URL="postgresql://assetflow:assetflow@localhost:5433/assetflow?schema=public"

# --- Redis ----------------------------------------------------------------
# Job queue, rate-limit counters and live notifications.
REDIS_URL="redis://localhost:6379"

# --- Auth -----------------------------------------------------------------
# Signs session tokens. Generate with: npx auth secret
# Use a different value in every environment.
AUTH_SECRET="replace-with-a-long-random-string"
# Public address of the app. Set on a real server (used for trusted host and emailed links).
# AUTH_URL="https://assets.example.com"
# Local production-mode runs (npm start, load tests) only; not needed in development.
# AUTH_TRUST_HOST="true"

# --- App ------------------------------------------------------------------
# Base address used in verification and password-reset emails. Required in production.
APP_URL="http://localhost:3000"
# Where uploaded photos are stored (default ./uploads). Use a persistent volume on a server.
UPLOAD_DIR="./uploads"

# --- Email -----------------------------------------------------
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="you@example.com"
# SMTP_PASS="your-app-password"
# MAIL_FROM="AssetFlow <you@example.com>"

# --- Load testing / tests only -------------------------------------------
# NEVER set these on a real server.
# RATE_LIMIT_DISABLED="true"
# RATE_LIMIT_STORE="memory"
# QUEUE_MODE="inline"
