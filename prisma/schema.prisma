generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ────────────────────────────────────────────

enum Role {
  ADMIN
  ASSET_MANAGER
  DEPARTMENT_HEAD
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum AssetCondition {
  GOOD
  FAIR
  POOR
}

enum AssetStatus {
  AVAILABLE
  ALLOCATED
  RESERVED
  UNDER_MAINTENANCE
  LOST
  RETIRED
  DISPOSED
}

enum HolderType {
  EMPLOYEE
  DEPARTMENT
}

enum AllocationStatus {
  ACTIVE
  RETURNED
  OVERDUE
}

enum TransferStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum BookingStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MaintenanceStatus {
  PENDING
  APPROVED
  REJECTED
  IN_PROGRESS
  RESOLVED
}

enum AuditScopeType {
  DEPARTMENT
  LOCATION
  ALL
}

enum AuditCycleStatus {
  ACTIVE
  CLOSED
}

enum FindingStatus {
  VERIFIED
  MISSING
  DAMAGED
}

// ── Identity ─────────────────────────────────────────

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role       @default(EMPLOYEE)
  departmentId Int?
  status       UserStatus @default(ACTIVE)
  // Null until the person opens the link emailed at signup. Sign-in needs it.
  emailVerifiedAt DateTime?
  // Part of every session (JWT). Bumping it signs the user out everywhere.
  sessionVersion  Int       @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  department          Department?          @relation("DeptEmployees", fields: [departmentId], references: [id])
  headOfDepartments   Department[]         @relation("DeptHead")
  allocationsHeld     Allocation[]         @relation("AllocationHolder")
  transfersRequested  TransferRequest[]    @relation("TransferRequestedBy")
  transfersApproved   TransferRequest[]    @relation("TransferApprovedBy")
  bookings            ResourceBooking[]
  maintenanceRaised   MaintenanceRequest[] @relation("MaintenanceRequester")
  maintenanceApproved MaintenanceRequest[] @relation("MaintenanceApprover")
  maintenanceAssigned MaintenanceRequest[] @relation("MaintenanceTechnician")
  assetHistory        AssetHistory[]       @relation("AssetHistoryActor")
  auditAssignments    AuditAssignment[]
  auditFindings       AuditFinding[]
  notifications       Notification[]
  activityLogs        ActivityLog[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  @@index([status])
}

// One row per "forgot password" request. Only a SHA-256 hash of the token is
// stored, so a leaked database can't be used to reset anyone's password.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Department {
  id           Int        @id @default(autoincrement())
  name         String
  description  String?
  parentDeptId Int?
  headId       Int?
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  parent          Department?  @relation("DeptHierarchy", fields: [parentDeptId], references: [id])
  children        Department[] @relation("DeptHierarchy")
  head            User?        @relation("DeptHead", fields: [headId], references: [id])
  employees       User[]       @relation("DeptEmployees")
  assets          Asset[]      @relation("AssetOwner")
  allocationsHeld Allocation[] @relation("AllocationHolderDept")

  @@index([status])
  @@index([parentDeptId])
}

// ── Catalog ──────────────────────────────────────────

model AssetCategory {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  description  String?
  customFields String   @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assets Asset[]
}

model Asset {
  id              Int            @id @default(autoincrement())
  assetTag        String         @unique
  name            String
  categoryId      Int
  serialNumber    String?        @unique
  acquisitionDate DateTime?
  acquisitionCost Float?
  condition       AssetCondition @default(GOOD)
  location        String?
  isBookable      Boolean        @default(false)
  status          AssetStatus    @default(AVAILABLE)
  photoUrl        String?
  notes           String?
  /// The department that owns this asset. It stays put while the asset is lent out;
  /// who holds it right now is the active Allocation. Null = not assigned to anyone.
  departmentId    Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  category      AssetCategory        @relation(fields: [categoryId], references: [id])
  department    Department?          @relation("AssetOwner", fields: [departmentId], references: [id], onDelete: Restrict)
  history       AssetHistory[]
  allocations   Allocation[]
  transfers     TransferRequest[]
  bookings      ResourceBooking[]
  maintenance   MaintenanceRequest[]
  auditFindings AuditFinding[]

  @@index([status])
  @@index([categoryId])
  @@index([isBookable])
  @@index([departmentId])
}

model AssetHistory {
  id         Int          @id @default(autoincrement())
  assetId    Int
  fromStatus AssetStatus?
  toStatus   AssetStatus
  actorId    Int
  reason     String?
  createdAt  DateTime     @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  actor User  @relation("AssetHistoryActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([assetId])
  @@index([actorId])
}

// ── Holding ──────────────────────────────────────────

model Allocation {
  id                 Int              @id @default(autoincrement())
  assetId            Int
  holderId           Int?
  holderDeptId       Int?
  holderType         HolderType
  expectedReturnDate DateTime?
  allocatedDate      DateTime         @default(now())
  returnedDate       DateTime?
  returnCondition    AssetCondition?
  returnNotes        String?
  status             AllocationStatus @default(ACTIVE)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  asset      Asset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  holder     User?       @relation("AllocationHolder", fields: [holderId], references: [id])
  holderDept Department? @relation("AllocationHolderDept", fields: [holderDeptId], references: [id], onDelete: Restrict)
  // "Only one ACTIVE allocation per asset" is enforced by a partial unique
  // index created in raw SQL (migration 20261017120000_concurrency_constraints).
  // Prisma can't declare it, so DON'T let `migrate dev` drop it.

  @@index([assetId])
  @@index([holderId])
  @@index([holderDeptId])
  @@index([status])
  @@index([expectedReturnDate])
  @@index([assetId, status])
}

model TransferRequest {
  id           Int            @id @default(autoincrement())
  assetId      Int
  fromHolderId Int?
  toHolderId   Int
  requestedBy  Int
  reason       String?
  status       TransferStatus @default(PENDING)
  approvedBy   Int?
  approvedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  asset     Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  requester User  @relation("TransferRequestedBy", fields: [requestedBy], references: [id])
  approver  User? @relation("TransferApprovedBy", fields: [approvedBy], references: [id])

  @@index([assetId])
  @@index([status])
}

// ── Booking ──────────────────────────────────────────

model ResourceBooking {
  id           Int           @id @default(autoincrement())
  resourceId   Int
  bookerId     Int
  startTime    DateTime
  endTime      DateTime
  purpose      String?
  status       BookingStatus @default(UPCOMING)
  reminderSent Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  resource Asset @relation(fields: [resourceId], references: [id])
  booker   User  @relation(fields: [bookerId], references: [id])
  // Overlap prevention: row lock in lib/bookings.ts plus the gist exclusion
  // constraint "booking_no_overlap" (raw SQL migration). Prisma can't declare it.

  @@index([resourceId])
  @@index([bookerId])
  @@index([status])
  @@index([startTime, endTime])
  @@index([resourceId, startTime, endTime])
}

// ── Maintenance ──────────────────────────────────────

model MaintenanceRequest {
  id              Int                 @id @default(autoincrement())
  assetId         Int
  requesterId     Int
  description     String
  priority        MaintenancePriority @default(MEDIUM)
  photoUrl        String?
  status          MaintenanceStatus   @default(PENDING)
  approvedBy      Int?
  approvedAt      DateTime?
  technicianId    Int?
  assignedAt      DateTime?
  resolutionNotes String?
  resolvedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  asset      Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  requester  User  @relation("MaintenanceRequester", fields: [requesterId], references: [id])
  approver   User? @relation("MaintenanceApprover", fields: [approvedBy], references: [id])
  technician User? @relation("MaintenanceTechnician", fields: [technicianId], references: [id], onDelete: Restrict)

  @@index([assetId])
  @@index([status])
  @@index([requesterId])
  @@index([technicianId])
}

// ── Audit ────────────────────────────────────────────

model AuditCycle {
  id            Int              @id @default(autoincrement())
  name          String
  scopeType     AuditScopeType
  scopeId       Int?
  // For LOCATION scope: assets whose location contains this text.
  scopeLocation String?
  startDate     DateTime
  endDate       DateTime
  status        AuditCycleStatus @default(ACTIVE)
  createdBy     Int
  closedBy      Int?
  closedAt      DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  assignments AuditAssignment[]
  findings    AuditFinding[]
}

model AuditAssignment {
  id         Int      @id @default(autoincrement())
  cycleId    Int
  auditorId  Int
  assignedAt DateTime @default(now())

  cycle   AuditCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  auditor User       @relation(fields: [auditorId], references: [id])

  @@unique([cycleId, auditorId])
}

model AuditFinding {
  id               Int             @id @default(autoincrement())
  cycleId          Int
  assetId          Int
  auditorId        Int
  status           FindingStatus
  auditorNotes     String?
  conditionBefore  AssetCondition?
  conditionAfter   AssetCondition?
  // PENDING until an Asset Manager / Admin decides: APPROVED or REJECTED.
  resolutionStatus String          @default("PENDING")
  resolvedBy       Int?
  resolvedAt       DateTime?
  resolutionNotes  String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  cycle   AuditCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  asset   Asset      @relation(fields: [assetId], references: [id])
  auditor User       @relation(fields: [auditorId], references: [id])

  @@unique([cycleId, assetId])
  @@index([cycleId])
  @@index([assetId])
  @@index([status])
}

// ── Activity ─────────────────────────────────────────

model Notification {
  id                  Int       @id @default(autoincrement())
  userId              Int
  type                String
  subject             String?
  message             String
  relatedResourceType String?
  relatedResourceId   Int?
  isRead              Boolean   @default(false)
  createdAt           DateTime  @default(now())
  readAt              DateTime?
  /// The activity event this came from; with userId and type it makes delivery idempotent.
  activityLogId       Int?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityLog ActivityLog? @relation(fields: [activityLogId], references: [id], onDelete: SetNull)

  @@unique([activityLogId, userId, type])
  @@index([userId, isRead])
  @@index([createdAt])
}

model ActivityLog {
  id              Int       @id @default(autoincrement())
  actorId         Int?
  action          String
  resourceType    String?
  resourceId      Int?
  changes         String?
  timestamp       DateTime  @default(now())
  /// Outbox: set once this event's notifications have been created.
  processedAt     DateTime?
  /// Outbox: failed delivery attempts; the relay stops retrying at 5.
  processAttempts Int       @default(0)

  actor         User?          @relation(fields: [actorId], references: [id])
  notifications Notification[]

  @@index([actorId])
  @@index([resourceType, resourceId])
  @@index([timestamp])
  @@index([actorId, timestamp])
  @@index([processedAt, id])
}
